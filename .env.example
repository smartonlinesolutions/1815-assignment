# Copy to .env to override the defaults in docker-compose.yml. Optional.

# Your host user, so files created in ./app belong to you.
# Linux/macOS: run `id -u` and `id -g`. Rebuild after changing: docker compose build
HOST_UID=1000
HOST_GID=1000

WEB_PORT=8080

DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

# One value used for all eight WordPress keys/salts (local dev only).
WP_SALT=change-me

WP_TITLE=Havenpost
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com
